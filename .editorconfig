# EditorConfig: https://EditorConfig.org
# 统一所有编辑器的代码格式

root = true

# 所有文件的默认设置
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python 文件
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# YAML 文件
[*.{yaml,yml}]
indent_style = space
indent_size = 2
max_line_length = 80

# JSON 文件
[*.json]
indent_style = space
indent_size = 2

# XML/URDF 文件
[*.{xml,urdf,xacro}]
indent_style = space
indent_size = 2
max_line_length = 120

# Markdown 文件
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

# Makefile
[Makefile]
indent_style = tab
indent_size = 4

# Shell 脚本
[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

# Batch 脚本
[*.{bat,cmd}]
end_of_line = crlf
