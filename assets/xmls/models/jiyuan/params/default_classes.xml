<?xml version='1.0' encoding='utf-8'?>
<mujoco>
  <!-- Default classes -->
  <visual>
    <quality shadowsize="4096" />
  </visual>

  <default>
    <default class="robot">
      <default class="motor">
        <!-- 主要运动关节：hip, knee -->
        <joint damping="0.5" armature="0.01" frictionloss="0.1"
          solreflimit="0.005 1" solimplimit="0.95 0.99 0.001" />
        <motor ctrllimited="true" ctrlrange="-1 1" />
      </default>
      <default class="ankle_motor">
        <!-- Three DOF 并联结构 -->
        <!-- 踝关节由 tendon 约束 -->
        <joint />
        <motor />
      </default>
      <default class="toe_motor">
        <!-- 脚趾关节：中等阻尼 -->
        <joint damping="0.2" armature="0.005" frictionloss="0.05"
          solreflimit="0.005 1" solimplimit="0.95 0.99 0.001" />
        <motor ctrllimited="true" ctrlrange="-1 1" />
      </default>
      <default class="visual">
        <!-- 视觉几何：不参与碰撞 -->
        <geom contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <!-- 躯干/髋部碰撞：组8，只碰撞地面(1) -->
        <geom condim="3" contype="8" conaffinity="1" priority="1" group="1" solref="0.005 1"
          solimp="0.99 0.999 1e-05" friction="1 0.01 0.01" mass="0" />
      </default>
      <default class="right_leg_collision">
        <!-- 右腿主体碰撞：组2，碰撞地面(1)和左腿(4) -->
        <geom condim="3" contype="2" conaffinity="5" priority="1" group="1" solref="0.005 1"
          solimp="0.99 0.999 1e-05" friction="1 0.01 0.01" mass="0" />
      </default>
      <default class="left_leg_collision">
        <!-- 左腿主体碰撞：组4，碰撞地面(1)和右腿(2) -->
        <geom condim="3" contype="4" conaffinity="3" priority="1" group="1" solref="0.005 1"
          solimp="0.99 0.999 1e-05" friction="1 0.01 0.01" mass="0" />
      </default>
      <default class="right_leg_minor_collision">
        <!-- 右腿细小部件（ankle）：组16，只碰撞地面(1) -->
        <geom condim="3" contype="16" conaffinity="1" priority="1" group="1" solref="0.005 1"
          solimp="0.99 0.999 1e-05" friction="1 0.01 0.01" mass="0" />
      </default>
      <default class="left_leg_minor_collision">
        <!-- 左腿细小部件（ankle）：组32，只碰撞地面(1) -->
        <geom condim="3" contype="32" conaffinity="1" priority="1" group="1" solref="0.005 1"
          solimp="0.99 0.999 1e-05" friction="1 0.01 0.01" mass="0" />
      </default>
      <default class="thigh_equality">
        <equality solref="0.001 1" solimp="0.99 0.999 0.0001" />
      </default>
    </default>
  </default>
</mujoco>