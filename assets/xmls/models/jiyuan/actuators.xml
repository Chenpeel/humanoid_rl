<?xml version='1.0' encoding='utf-8'?>
<mujoco>
  <!-- Actuators
       扭矩限制策略：
       - Hip pitch: 2.5 Nm (控制大腿前后摆动，功率较小)
       - 其他 Hip 关节 (yaw/roll): 8 Nm
       - Knee: 8 Nm
       - Ankle: 2.5 Nm (脚踝关节，精细控制)
       - Toe: 8 Nm
  -->
  <actuator>
    <!-- 右腿 -->
    <motor name="right_hip_pitch_engine_joint_ctrl" joint="right_hip_pitch_engine_joint"
      class="motor" ctrlrange="-2.5 2.5" forcerange="-2.5 2.5" />
    <motor name="right_hip_yaw_engine_joint_ctrl" joint="right_hip_yaw_engine_joint"
      class="motor" ctrlrange="-8 8" forcerange="-8 8" />
    <motor name="right_hip_roll_joint_ctrl" joint="right_hip_roll_joint"
      class="motor" ctrlrange="-8 8" forcerange="-8 8" />
    <motor name="right_knee_joint_ctrl" joint="right_knee_joint"
      class="motor" ctrlrange="-8 8" forcerange="-8 8" />
    <motor name="right_ankle_1_3_joint_ctrl" joint="right_ankle_1_3_joint"
      class="motor" ctrlrange="-2.5 2.5" forcerange="-2.5 2.5" />
    <motor name="right_ankle_2_3_joint_ctrl" joint="right_ankle_2_3_joint"
      class="motor" ctrlrange="-2.5 2.5" forcerange="-2.5 2.5" />
    <motor name="right_ankle_3_3_joint_ctrl" joint="right_ankle_3_3_joint"
      class="motor" ctrlrange="-2.5 2.5" forcerange="-2.5 2.5" />
    <motor name="right_toe_joint_ctrl" joint="right_toe_joint"
      class="motor" ctrlrange="-8 8" forcerange="-8 8" />

    <!-- 左腿 -->
    <motor name="left_hip_pitch_engine_joint_ctrl" joint="left_hip_pitch_engine_joint"
      class="motor" ctrlrange="-2.5 2.5" forcerange="-2.5 2.5" />
    <motor name="left_hip_yaw_engine_joint_ctrl" joint="left_hip_yaw_engine_joint"
      class="motor" ctrlrange="-8 8" forcerange="-8 8" />
    <motor name="left_hip_roll_joint_ctrl" joint="left_hip_roll_joint"
      class="motor" ctrlrange="-8 8" forcerange="-8 8" />
    <motor name="left_knee_joint_ctrl" joint="left_knee_joint"
      class="motor" ctrlrange="-8 8" forcerange="-8 8" />
    <motor name="left_ankle_1_3_joint_ctrl" joint="left_ankle_1_3_joint"
      class="motor" ctrlrange="-2.5 2.5" forcerange="-2.5 2.5" />
    <motor name="left_ankle_2_3_joint_ctrl" joint="left_ankle_2_3_joint"
      class="motor" ctrlrange="-2.5 2.5" forcerange="-2.5 2.5" />
    <motor name="left_ankle_3_3_joint_ctrl" joint="left_ankle_3_3_joint"
      class="motor" ctrlrange="-2.5 2.5" forcerange="-2.5 2.5" />
    <motor name="left_toe_joint_ctrl" joint="left_toe_joint"
      class="motor" ctrlrange="-8 8" forcerange="-8 8" />
  </actuator>
</mujoco>