<?xml version='1.0' encoding='utf-8'?>
<mujoco>
  <!-- Sensors -->
  <sensor>
    <!-- 基座IMU传感器 -->
    <framepos name="base_link_site_pos" objtype="site" objname="base_link_site" />
    <framequat name="base_link_site_quat" objtype="site" objname="base_link_site" />
    <framelinvel name="base_link_site_linvel" objtype="site" objname="base_link_site" />
    <frameangvel name="base_link_site_angvel" objtype="site" objname="base_link_site" />
    <velocimeter name="base_link_site_vel" site="base_link_site" />

    <!-- 足底触地传感器 (touch sensor) -->
    <!-- 使用touch类型传感器返回接触力，神经网络可自行学习阈值 -->

    <!-- 右脚触地传感器 -->
    <touch name="right_foot_contact" site="right_foot_touch_site" />
    <touch name="right_toe_contact" site="right_toe_touch_site" />

    <!-- 左脚触地传感器 -->
    <touch name="left_foot_contact" site="left_foot_touch_site" />
    <touch name="left_toe_contact" site="left_toe_touch_site" />

    <!--
    备选方案：压力传感器 (force sensor)
    如果后期需要精确的力值信息，可以使用force传感器替代touch
    force传感器会返回6维力/力矩向量 [fx, fy, fz, tx, ty, tz]
    但会增加观测维度（每个传感器+6维），且真机部署难度更大

    <force name="right_foot_force" site="right_foot_touch_site" />
    <force name="right_toe_force" site="right_toe_touch_site" />
    <force name="left_foot_force" site="left_foot_touch_site" />
    <force name="left_toe_force" site="left_toe_touch_site" />
    -->
  </sensor>
</mujoco>