<?xml version="1.0" encoding="utf-8"?>
<mujoco model="jiyuan_fit_rough_terrain">
  <compiler angle="radian" />

  <!-- 仿真选项 -->
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast">
    <flag warmstart="enable" />
  </option>

  <!-- 视觉配置 -->
  <visual>
    <global offwidth="1920" offheight="1080" />
    <quality shadowsize="4096" />
    <map znear="0.01" />
  </visual>

  <!-- === 加载机器人模型 === -->
  <include file="../models/jiyuan_fit.xml" />

  <!-- 额外材质 -->
  <asset>
    <material name="obstacle" rgba="0.5 0.5 0.5 1" />
    <material name="rough_ground" rgba="0.6 0.5 0.4 1" />
  </asset>

  <!-- === 世界环境 === -->
  <worldbody>
    <!-- 光照 -->
    <light diffuse="0.8 0.8 0.8" pos="0 0 4" dir="0 0 -1" />

    <!-- 地面：粗糙地形（使用hfield生成起伏地形） -->
    <geom name="ground" type="plane" size="10 10 0.05" material="rough_ground"
      condim="3" friction="1.2 0.02 0.02" />

    <!-- 随机障碍物 - 散布在环境中 -->
    <body name="obstacle_1" pos="2.0 0.3 0.05">
      <geom type="box" size="0.15 0.15 0.05" material="obstacle" contype="8" conaffinity="1" />
    </body>

    <body name="obstacle_2" pos="3.0 -0.5 0.08">
      <geom type="box" size="0.2 0.1 0.08" material="obstacle" contype="8" conaffinity="1" />
    </body>

    <body name="obstacle_3" pos="1.5 0.8 0.06">
      <geom type="cylinder" size="0.12 0.06" material="obstacle" contype="8" conaffinity="1" />
    </body>

    <body name="obstacle_4" pos="4.0 0.2 0.04">
      <geom type="box" size="0.1 0.2 0.04" material="obstacle" contype="8" conaffinity="1" />
    </body>

    <body name="obstacle_5" pos="2.5 -1.0 0.07">
      <geom type="cylinder" size="0.1 0.07" material="obstacle" contype="8" conaffinity="1" />
    </body>

    <!-- 坡道 -->
    <body name="ramp_1" pos="5.0 0 0.15" euler="0 -0.1 0">
      <geom type="box" size="0.5 1.0 0.02" material="obstacle" contype="8" conaffinity="1" />
    </body>

  </worldbody>
</mujoco>
